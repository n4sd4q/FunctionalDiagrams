  \fill (-0.700,1.850) circle (0.064);
  \fill (0.700,1.850) circle (0.064);
  \node[font=\tiny, inner sep=0pt, anchor=0] at (-1.390,0.000) {$x$};
  \node[font=\tiny, inner sep=0pt, anchor=180] at (1.390,0.000) {$y$};
\end{tikzpicture}